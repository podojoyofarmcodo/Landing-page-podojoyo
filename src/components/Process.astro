---
const steps = [
  {
    time: '04:00',
    title: 'Pemerahan Pagi',
    description: 'Proses pemerahan higienis dilakukan pagi hari dari sapi yang sehat dan bahagia.'
  },
  {
    time: '05:30',
    title: 'Penyaringan',
    description: 'Susu segera disaring untuk memastikan kebersihan maksimal dari segala kotoran.'
  },
  {
    time: '06:00',
    title: 'Proses Pasteurisasi',
    description: '(Untuk varian matang) Susu dipanaskan perlahan dan didinginkan cepat untuk mematikan bakteri.'
  },
  {
    time: '07:30',
    title: 'Mulai Pengiriman',
    description: 'Susu dimasukkan box pendingin dan dikirimkan oleh kurir kami sebelum matahari meninggi.'
  }
];
---

<section class="py-16 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-2 lg:gap-16 items-center">
      <div>
        <h2 class="text-3xl font-extrabold text-brand-dark sm:text-4xl">
          Transparansi Proses Kami
        </h2>
        <p class="mt-4 text-lg text-gray-600 mb-8">
          Kami memastikan rantai pasok yang singkat dan transparan. Susu yang Anda terima pagi ini adalah susu yang diperah hanya beberapa jam sebelumnya.
        </p>
        
        <div class="relative">
          <!-- Garis vertikal timeline -->
          <div class="absolute inset-0 flex items-center justify-center w-8 h-full">
            <div class="w-1 h-full bg-gray-200 pointer-events-none"></div>
          </div>
          
          <ul class="relative z-10 space-y-8">
            {steps.map((step) => (
              <li class="flex items-start">
                <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-brand-accent text-white font-bold text-xs ring-4 ring-white shadow-sm mt-1">
                  {step.time.split(':')[0]}
                </div>
                <div class="ml-4">
                  <h3 class="text-lg font-bold text-brand-dark flex items-center gap-2">
                    {step.title}
                    <span class="text-sm font-medium text-brand-accent px-2 py-0.5 rounded-full bg-green-50">{step.time} WIB</span>
                  </h3>
                  <p class="mt-1 text-gray-600">{step.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
      
      <div class="mt-12 lg:mt-0">
        <div class="relative rounded-2xl overflow-hidden shadow-xl">
          <img src="https://images.unsplash.com/photo-1596731057497-6a4be7562085?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Proses pengolahan susu sapi" class="w-full h-auto object-cover rounded-2xl" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-end">
            <div class="p-8">
              <p class="text-white font-bold text-xl">Rantai Pasok Singkat</p>
              <p class="text-white/80 mt-1">Langsung dari peternak lokal di Malang ke meja makan Anda.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
